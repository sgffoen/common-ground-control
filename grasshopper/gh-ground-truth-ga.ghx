                    <item name="Description" type_name="gh_string" type_code="10">A group of Grasshopper objects</item>
                    <item name="ID" index="0" type_name="gh_guid" type_code="9">2203440b-d1eb-49cc-beeb-21a32f9efebf</item>
                    <item name="ID" index="1" type_name="gh_guid" type_code="9">e23a8823-bceb-4954-ad6b-cf819f1abc23</item>
                    <item name="ID" index="2" type_name="gh_guid" type_code="9">327bf863-52a9-4803-8223-532a17aa2c32</item>
                    <item name="ID" index="3" type_name="gh_guid" type_code="9">0703b1ca-fed6-445b-b617-b8c08176d240</item>
