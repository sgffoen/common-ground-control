              <chunks count="1">
                <chunk name="Container">
                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10"># LIBRARIES
import ghpythonlib.treehelpers as th
import Rhino.Geometry as rg
import math as m

# hard corded values
fig_size = 256
tolerance = 10
hm_xbounds = [17, 1152]
hm_ybounds = [-22, -751]
hm_zbounds = [0, 130]
hm_bounds = [hm_xbounds, hm_ybounds, hm_zbounds]
hm_bounds = th.list_to_tree(hm_bounds)

# offset distance from the edge of sandbox
offset_dist = ((fig_size * m.sqrt(2)) / 2) + tolerance

# bounds for drawing area
c_xbounds = [17+offset_dist, 1152-offset_dist]
c_ybounds = [-22-offset_dist, -751+offset_dist]
c_zbounds = [0, 130]
c_bounds = [c_xbounds, c_ybounds, c_zbounds]
c_bounds = th.list_to_tree(c_bounds)

# draw canvas
xint = rg.Interval(c_xbounds[0], c_xbounds[1])
yint = rg.Interval(c_ybounds[0], c_ybounds[1])
plane = rg.Plane(rg.Point3d(0,0,130), rg.Vector3d.XAxis, rg.Vector3d.YAxis)
canvas = rg.Rectangle3d(plane, xint, yint)

xint = rg.Interval(hm_xbounds[0], hm_xbounds[1])
yint = rg.Interval(hm_ybounds[0], hm_ybounds[1])
plane = rg.Plane(rg.Point3d(0,0,130), rg.Vector3d.XAxis, rg.Vector3d.YAxis)
hm_canvas = rg.Rectangle3d(plane, xint, yint)
</item>
                    <item name="Description" type_name="gh_string" type_code="10">GhPython provides a Python script component</item>
