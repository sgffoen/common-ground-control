                  <items count="14">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas_ghpython import unload_modules
from compas_ghpython import artists
unload_modules('groundtruth')
from compas.rpc import Proxy


if interface:
    if scan_sandbox:
        f_scan = interface.scan_sandbox()
    if prediction:
        f_pred, tp = interface.prediction(toolpaths, adaptive, cellsize, depth)
</item>
