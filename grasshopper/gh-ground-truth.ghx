            <chunk name="Object" index="12">
              <items count="3">
                <item name="GUID" type_name="gh_guid" type_code="9">410755b1-224a-4c1e-a407-bf32fb45ea7e</item>
                <item name="Lib" type_name="gh_guid" type_code="9">00000000-0000-0000-0000-000000000000</item>
                <item name="Name" type_name="gh_string" type_code="10">GhPython Script</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="12">
                    <item name="CodeInput" type_name="gh_string" type_code="10">import compas_ghpython as cgh
import compas.geometry as cg
import random as r

xmax = 1135
ymin = -737
zmax = 100
offset = 125
num_crv = 50
length = 50


def generate_toolpaths():
    toolpaths = []
    for i in range(num_crv):
        x_coord = r.randint(offset, xmax-offset)
        y_coord = r.randint(ymin+offset, 0-offset)
        z_coord = r.randint(50, zmax)
        pt = cg.Point(x_coord, y_coord, z_coord)
        
        delta = r.random()
        vec = cg.Vector(0, length, 0)
        
        T = cg.Translation.from_vector(vec)
        pt_end = pt.transformed(T)
        
        pl = cg.Polyline([pt, pt_end])
        toolpaths.append(pl)
    return toolpaths


def draw_toolpaths(c_toolpaths):
    gh_toolpaths = []
    for tp in c_toolpaths:
        artist = cgh.artists.PolylineArtist(tp)
        pl = artist.draw()[0]
        gh_toolpaths.append(pl)
    return gh_toolpaths


c_toolpaths = generate_toolpaths()
gh_toolpaths = draw_toolpaths(c_toolpaths)</item>
