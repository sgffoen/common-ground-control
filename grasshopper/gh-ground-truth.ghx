                    <item name="CodeInput" type_name="gh_string" type_code="10">import ghpythonlib.treehelpers as th
import Rhino.Geometry as rg
import compas.geometry as cg
from compas_ghpython.artists import PointArtist, FrameArtist, PolylineArtist

if tp[0] != None:
    frames_tree = []
    pts_tree = []
    pls_list = []
    for t in tp:
        frames_list = []
        pts_list = []
        for f in t:
            f_new = f.copy()
            f_new.point.y *= (-1)
            artist = FrameArtist(f_new)
            plane = artist.draw()
            frames_list.append(plane)
            pts_list.append(plane.Origin)
        # frames
        frames_tree.append(frames_list)
        # pts
        pts_tree.append(pts_list)
        # polyline
        pl = rg.Polyline(pts_list)
        pls_list.append(pl)
    
    if vis_type == 0:
        vis = pts_tree
        vis = th.list_to_tree(vis)
    elif vis_type == 1:
        vis = frames_tree
        vis = th.list_to_tree(vis)
    elif vis_type == 2:
        vis = pls_list
</item>
