              <chunks count="1">
                <chunk name="Container">
                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas_ghpython import unload_modules
unload_modules('groundtruth')
from compas.rpc import Proxy

#proxy=Proxy()
#proxy.stop_server()

interface = None

if activate:
    if start_proxy:
        interface = Proxy('groundtruth.interactive.interface')
    else:
        Proxy.stop_server(interface)
        
        
if interface:
    f = interface.get_height_grid()
    </item>
