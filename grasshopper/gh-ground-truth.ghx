              <chunks count="1">
                <chunk name="Container">
                  <items count="14">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas_ghpython import unload_modules
from compas_ghpython import artists
unload_modules('groundtruth')
from compas.rpc import Proxy

interface = None

if activate:
    interface = Proxy('groundtruth.interactive.interface')
    if initialise_proxy:
        interface.restart_server()
    if start_proxy:
        interface.start_server()
    else:
        interface.stop_server()
        
        
if interface and start_proxy:
    if scan_sandbox:
        f = interface.scan_sandbox()
    if prediction:
        f, tp = interface.prediction(toolpaths, adaptive)
    if fix:
        interface.fix_design(tp, iteration)
</item>
