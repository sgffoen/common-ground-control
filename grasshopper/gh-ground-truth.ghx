            <chunk name="Object" index="9">
              <items count="3">
                <item name="GUID" type_name="gh_guid" type_code="9">410755b1-224a-4c1e-a407-bf32fb45ea7e</item>
                <item name="Lib" type_name="gh_guid" type_code="9">00000000-0000-0000-0000-000000000000</item>
                <item name="Name" type_name="gh_string" type_code="10">GhPython Script</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">import ghpythonlib.treehelpers as th
import compas_ghpython as cgh
import compas.geometry as cg
import random as r
import math as m


def generate_toolpaths(c_bounds, num_crv, seed):
    xbounds = c_bounds[0]
    ybounds = c_bounds[1]
    zbounds = c_bounds[2]
    lbounds = [30, 150]
    
    toolpaths = []
    for i in range(num_crv):
        x_coord = r.randint(xbounds[0], xbounds[1])
        y_coord = r.randint(ybounds[1], ybounds[0])
        z_coord = 130
        pt = cg.Point(x_coord, y_coord, z_coord)
        
        delta = r.random()
        length = r.randint(lbounds[0], lbounds[1])
        vec = cg.Vector(-length, 0, 0)
        
        T = cg.Translation.from_vector(vec)
        pt_end = pt.transformed(T)
        
        pl = cg.Polyline([pt, pt_end])
        
        # set angle
        angle = r.randint(0, 180)
        
        toolpaths.append(pl)
    return toolpaths


def draw_toolpaths(c_toolpaths):
    gh_toolpaths = []
    for tp in c_toolpaths:
        artist = cgh.artists.PolylineArtist(tp)
        pl = artist.draw()[0]
        gh_toolpaths.append(pl)
    return gh_toolpaths

c_bounds = th.tree_to_list(c_bounds)
c_toolpaths = generate_toolpaths(c_bounds, num_crv, seed)
gh_toolpaths = draw_toolpaths(c_toolpaths)</item>
                    <item name="Description" type_name="gh_string" type_code="10">GhPython provides a Python script component</item>
                    <item name="EditorLocation" type_name="gh_drawing_point" type_code="30">
                      <X>192</X>
                      <Y>192</Y>
                    </item>
                    <item name="EditorSize" type_name="gh_drawing_size" type_code="32">
                      <W>741</W>
                      <H>1004</H>
                    </item>
                    <item name="Hidden" type_name="gh_bool" type_code="1">true</item>
                    <item name="HideInput" type_name="gh_bool" type_code="1">true</item>
