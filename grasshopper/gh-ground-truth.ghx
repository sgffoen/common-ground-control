              <chunks count="1">
                <chunk name="Container">
                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">import ghpythonlib.treehelpers as th
import compas_ghpython as cgh
import compas.geometry as cg
import random as r
import math as m


def generate_toolpaths(c_bounds, num_crv, seed):
    xbounds = c_bounds[0]
    ybounds = c_bounds[1]
    zbounds = c_bounds[2]
    lbounds = [30, 150]
    
    toolpaths = []
    for i in range(num_crv):
        x_coord = r.randint(xbounds[0], xbounds[1])
        y_coord = r.randint(ybounds[1], ybounds[0])
        z_coord = 130
        pt = cg.Point(x_coord, y_coord, z_coord)
        
        delta = r.random()
        length = r.randint(lbounds[0], lbounds[1])
        vec = cg.Vector(-length, 0, 0)
        
        T = cg.Translation.from_vector(vec)
        pt_end = pt.transformed(T)
        
        pl = cg.Polyline([pt, pt_end])
        
        # set angle
        angle = r.randint(0, 180)
        
        toolpaths.append(pl)
    return toolpaths


def draw_toolpaths(c_toolpaths):
    gh_toolpaths = []
    for tp in c_toolpaths:
        artist = cgh.artists.PolylineArtist(tp)
        pl = artist.draw()[0]
        gh_toolpaths.append(pl)
    return gh_toolpaths

c_bounds = th.tree_to_list(c_bounds)
c_toolpaths = generate_toolpaths(c_bounds, num_crv, seed)
gh_toolpaths = draw_toolpaths(c_toolpaths)</item>
