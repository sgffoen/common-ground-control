                    <item name="CodeInput" type_name="gh_string" type_code="10">import ghpythonlib.treehelpers as th
import Rhino.Geometry as rg
import compas.geometry as cg
from compas_ghpython.artists import PointArtist, FrameArtist, PolylineArtist
import json

__GH_EXPORT__ = "G:/Shared drives/2021_MAS/T3/Common Ground Control/01_data/02_demo/01_interactive-gh/00_designs"

def export_json(dir, data, iter):
    id_num = str(iter).zfill(3)
    filepath = dir + '/{}_toolpaths.json'.format(id_num)
    with open(filepath, 'w') as o:
        json.dump(data, o, indent=4)


def export_design(tp, iteration):
    # initiate data
    data = {}
    # store control frames
    for i, f_list in enumerate(tp):
        toolpath_num = str(i).zfill(3)
        toolpath_key = 'toolpath_{}'.format(toolpath_num)
        data[toolpath_key] = {}
        for j, f in enumerate(f_list):
            frame_num = str(j).zfill(3)
            frame_key = 'f_{}'.format(frame_num)
            # mirror
            f_mirror = f.copy()
            f_mirror.point.y *= (-1)
            data[toolpath_key][frame_key] = f_mirror.to_jsonstring()
    # export json
    export_json(dir=__GH_EXPORT__, data=data, iter=iteration)


def remapValue(v, ori_Min, ori_Max, targetMin, targetMax):
    rv = ((v-ori_Min)/(ori_Max-ori_Min))*(targetMax-targetMin)+targetMin
    return rv

if tp[0] != None:
    frames_tree = []
    pts_tree = []
    pls_list = []
    compas_tree = []
    for t in tp:
        frames_list = []
        compas_list = []
        pts_list = []
        for f in t:
            f_mirror = f.copy()
            f_mirror.point.y *= (-1)
            # move frame
            framefrom = cg.Frame(cg.Point(0, 0, 0),
                                 cg.Vector.Xaxis(),
                                 cg.Vector.Yaxis())
            frameto = cg.Frame(cg.Point(17,
                                        -22,
                                        0),
                               cg.Vector.Xaxis(),
                               cg.Vector.Yaxis())
            T = cg.Transformation.from_frame_to_frame(framefrom, frameto)
            f_moved = f_mirror.transformed(T)
            f_compas = f_moved.copy()
            # remap z_values
            f_moved.point.z = remapValue(f_moved.point.z, 0, 130, 130, 0)
            # call artist
            compas_list.append(f_compas)
            artist = FrameArtist(f_moved)
            plane = artist.draw()
            frames_list.append(plane)
            pts_list.append(plane.Origin)
        compas_tree.append(compas_list)
        # frames
        frames_tree.append(frames_list)
        # pts
        pts_tree.append(pts_list)
        # polyline
        pl = rg.Polyline(pts_list)
        pls_list.append(pl)
    
    if vis_type == 0:
        vis = pts_tree
        vis = th.list_to_tree(vis)
    elif vis_type == 1:
        vis = frames_tree
        vis = th.list_to_tree(vis)
    elif vis_type == 2:
        vis = pls_list



if export:
    export_design(compas_tree, iteration)</item>
